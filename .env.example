# Which AI to use: auto | gemini | openai | offline
# "auto" picks Gemini if GEMINI_API_KEY is set, else OpenAI, else the offline rule engine.
AI_PROVIDER=auto

# Google Gemini (free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (or any OpenAI-compatible API such as Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AI_TIMEOUT_SECONDS=20
ADMIN_PASSWORD=change-me
DATABASE_PATH=data/clinicflow.db
CLINIC_NAME=Robina 7 Day Doctors (Demo)
CLINIC_TIMEZONE=Australia/Brisbane
